<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VF6 Split Mirror"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_left"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_left"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_right"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <Spinner
            android:id="@+id/spinner_right"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <Button
            android:id="@+id/button_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_accessibility"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/button_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_pair"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/button_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop_mirror"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_ready"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
